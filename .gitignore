# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---- 打包产物（PyInstaller，75MB，禁止入库）----
# 通配覆盖全部 distpath 命名（dist/ dist2/ dist_smoke/ ...），换目录名无需再补规则
dist*/
build*/
*.manifest

# ---- 宣传页内的打包分发副本（31.5MB 构建产物，改走 GitHub Release 附件）----
宣传页/*.zip
宣传页/plugin-assets/

# ---- 运行数据（个人碎片/笔记/任务/日志，隐私；2026-09-27 起统一收纳进 float_data/）----
data/
float_data/
temp_assets/
*.log

# ---- 个人知识库数据源 ----
知识库.docx
知识库.docx.bak

# ---- 内部开发文档与 AI 会话数据（2026-09-29 起不入公开仓库，本地保留）----
.zcode*
docs/

# ---- 本地开发与发布用产物：对外无意义，私留在工作区 ----
# .gitignore/外部工具配置、插件源包仓（改由 release.yml 现场从 plugins/ 打包）、
# 巡检与打包冒烟脚本（纯本地流程）
plugin_store/
tools/git_autopilot.py
tools/smoke_packaged.py

# ---- 本地会话与编辑器 ----
.workbuddy/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
