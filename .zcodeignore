# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---- 打包产物（PyInstaller，75MB，禁止入库）----
dist2/
build2/
dist/
build/
*.manifest

# ---- 宣传页内的打包分发副本（31.5MB 构建产物，改走 GitHub Release 附件）----
宣传页/*.zip

# ---- 运行数据（个人碎片/笔记/任务/日志，隐私；2026-09-27 起统一收纳进 float_data/）----
data/
float_data/
temp_assets/
*.log

# ---- 个人知识库数据源 ----
知识库.docx
知识库.docx.bak

# ---- 本地会话与编辑器 ----
.workbuddy/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
