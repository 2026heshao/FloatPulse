{
  "id": "ai-text-workshop",
  "name": "AI 文本工坊",
  "version": "1.6.0",
  "entry": "plugin.py",
  "requires": [
    "PyQt6.QtCore",
    "PyQt6.QtGui",
    "PyQt6.QtWidgets"
  ],
  "capabilities": [
    "network",
    "write",
    "ai"
  ],
  "page": {
    "title": "✂ 文本工坊"
  },
  "settings": [
    {
      "key": "temperature",
      "label": "输出发散度",
      "type": "float",
      "default": 0.4,
      "min": 0.1,
      "max": 1.0
    },
    {
      "key": "max_tokens",
      "label": "单次输出上限",
      "type": "int",
      "default": 2048,
      "min": 256,
      "max": 4096
    }
  ],
  "actions": [
    {
      "id": "ai-text-workshop.open",
      "title": "✂ AI 文本工坊",
      "hotkey": "Ctrl+Alt+T",
      "menu": false
    }
  ]
}
