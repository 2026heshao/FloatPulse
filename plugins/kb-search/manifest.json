{
  "id": "kb-search",
  "name": "站内搜索",
  "version": "1.5.0",
  "entry": "plugin.py",
  "requires": [
    "PyQt6.QtCore",
    "PyQt6.QtGui",
    "PyQt6.QtWidgets"
  ],
  "capabilities": [],
  "description": "在知识库 / 笔记 / 碎片 / 任务 / 素材里做全文检索：自研中文分词 + 倒排索引 + BM25 排序，命中片段带高亮，点结果标题跳转到对应面板。纯站内检索，不碰文件系统",
  "page": {
    "title": "🔍 站内搜索"
  },
  "settings": [
    {
      "key": "max_results",
      "label": "最大返回数",
      "type": "int",
      "default": 60,
      "min": 5,
      "max": 200
    },
    {
      "key": "search_notes",
      "label": "默认搜索笔记",
      "type": "bool",
      "default": true
    },
    {
      "key": "ranking",
      "label": "排序算法",
      "type": "enum",
      "default": "bm25",
      "choices": ["bm25", "tfidf"]
    }
  ],
  "actions": [
    {
      "id": "kb-search.open",
      "title": "🔍 站内搜索",
      "hotkey": "Ctrl+Alt+F",
      "menu": true
    }
  ]
}
